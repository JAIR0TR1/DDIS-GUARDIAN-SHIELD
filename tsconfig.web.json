{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/domain/**/*",
    "src/design/**/*",
    "data/demo-messages.json"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@domain/*": ["./src/domain/*"],
      "@design/*": ["./src/design/*"],
      "@data/*": ["./data/*"]
    }
  }
}
