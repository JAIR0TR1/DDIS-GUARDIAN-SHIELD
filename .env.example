# Copia este archivo como .env y completa tus valores. NUNCA subas .env al repositorio.

# Clave de Google AI Studio (plan gratuito). Solo se usa en el proceso main.
GEMINI_API_KEY=

# true = respuestas de ejemplo, sin internet ni clave. Se cambia reiniciando la app.
DEMO_MODE=true

# Modelo rápido (casos ambiguos y frases de la criatura). Se confirma en la fase 4.
MODEL_FAST=

# Modelo con visión (capturas de pantalla). Se confirma en la fase 4.
MODEL_VISION=
