# Copia este archivo como .env y completa tus valores. NUNCA subas .env al repositorio.

# Clave de Google AI Studio (plan gratuito). Solo la lee el proceso principal.
# En la app instalada se pega desde Ajustes y se guarda cifrada.
GEMINI_API_KEY=

# true = respuestas de ejemplo, sin internet ni clave. false = IA real (Gemini).
# Se cambia reiniciando la app.
DEMO_MODE=true

# Modelo rápido (casos ambiguos). Por defecto: gemini-3.5-flash-lite
MODEL_FAST=

# Modelo con visión (capturas, P1). Por defecto: gemini-3.8-flash
MODEL_VISION=
